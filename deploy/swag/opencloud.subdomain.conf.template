## OpenCloud ({{OC_STACK}}): https://{{OC_DOMAIN}}
## Written by setup.sh as swag/{{OC_STACK}}.subdomain.conf. Copy it to SWAG's
## config/nginx/proxy-confs/ and restart SWAG; its certificate must cover
## {{OC_DOMAIN}}. SWAG's own authelia-*.conf files are for protecting other
## apps and aren't used here.

server {
    listen 443 ssl;
    listen [::]:443 ssl;

    server_name {{OC_DOMAIN}};

    include /config/nginx/ssl.conf;

    # Uploads of any size, streamed straight through
    client_max_body_size 0;

    # Authelia (sign-in with 2FA); without it this answers 502 and isn't used
    location /authelia {
        # proxy.conf turns every http:// redirect into https://, which breaks
        # the desktop app's sign-in: it ends with a redirect to the app's own
        # http://127.0.0.1:<port>. The first matching rule wins, so these
        # (unchanged) come before it.
        proxy_redirect http://127.0.0.1 http://127.0.0.1;
        proxy_redirect http://localhost http://localhost;
        # Authelia takes the client's address (logs, sign-in history) from the
        # first X-Forwarded-For entry, and proxy.conf adds to whatever the
        # client sent. nginx sends both headers in order, so the real address
        # comes first.
        proxy_set_header X-Forwarded-For $remote_addr;
        # Authelia's settings pages (where 2FA is registered and passwords are
        # changed) have no way back to OpenCloud: its pages get the script
        # below, which adds a "Back to your files" button there. Plain HTML
        # from Authelia (no compression) so the line can be added.
        proxy_set_header Accept-Encoding "";
        sub_filter '</head>' '<script src="/authelia-back.js" defer></script></head>';
        sub_filter_once on;
        include /config/nginx/proxy.conf;
        include /config/nginx/resolver.conf;
        set $upstream_app {{OC_STACK}}-authelia;
        set $upstream_port 9091;
        set $upstream_proto http;
        proxy_pass $upstream_proto://$upstream_app:$upstream_port;
    }

    # The button for Authelia's settings pages (see above): a link to
    # OpenCloud, shown while the address is /authelia/settings…; in Hungarian
    # when Authelia's language (or else the browser's) is. Authelia's pages allow scripts from this
    # site only, so it's served here.
    location = /authelia-back.js {
        default_type "application/javascript; charset=utf-8";
        add_header Cache-Control "no-cache";
        return 200 '(function () {
  var lang = navigator.language || "";
  try { lang = localStorage.getItem("i18nextLng") || lang; } catch (e) {}
  var hu = /^hu/i.test(lang);
  var a = document.createElement("a");
  a.href = "/";
  a.id = "back-to-files";
  a.textContent = hu ? "← Vissza a fájljaihoz" : "← Back to your files";
  var s = a.style;
  s.position = "fixed"; s.top = "12px"; s.left = "50%"; s.transform = "translateX(-50%)"; s.zIndex = "2000";
  s.padding = "8px 16px"; s.borderRadius = "6px"; s.background = "#fff"; s.color = "#1976d2";
  s.textDecoration = "none"; s.font = "500 14px system-ui, sans-serif"; s.boxShadow = "0 1px 4px rgba(0,0,0,.3)";
  function show() { s.display = location.pathname.indexOf("/authelia/settings") === 0 ? "block" : "none"; }
  function start() { document.body.appendChild(a); show(); setInterval(show, 500); }
  if (document.body) start(); else document.addEventListener("DOMContentLoaded", start);
})();
';
    }

    # The management API (compose.manage.yaml), in OpenCloud's container's
    # network namespace; without it this answers 502. Only a management tool
    # needs it: to let only its address in, uncomment and fill in
    #     allow 203.0.113.7;
    #     deny all;
    location /manage-api/ {
        include /config/nginx/proxy.conf;
        include /config/nginx/resolver.conf;
        set $upstream_app {{OC_STACK}}-opencloud;
        set $upstream_port 9300;
        set $upstream_proto http;
        # The API's paths start at /v1/
        rewrite ^/manage-api(/.*)$ $1 break;
        proxy_pass $upstream_proto://$upstream_app:$upstream_port;
    }

    location / {
        include /config/nginx/proxy.conf;
        include /config/nginx/resolver.conf;
        # proxy.conf sets the timeouts and the websocket headers; uploads and
        # server-sent events must not be buffered
        proxy_buffering off;
        proxy_request_buffering off;
        set $upstream_app {{OC_STACK}}-opencloud;
        set $upstream_port 9200;
        set $upstream_proto http;
        proxy_pass $upstream_proto://$upstream_app:$upstream_port;
    }
}
