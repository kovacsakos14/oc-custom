# Copy to .env, fill in, then run ./setup.sh. Keep .env private (setup.sh
# makes it mode 600). Changes take effect with: docker compose up -d

# Prefix of the container names (unique per host: SWAG finds them by name)
OC_STACK=opencloud1
# The public name; SWAG has a certificate for it
OC_DOMAIN=cloud.example.com
# Used on the first start only (OpenCloud's admin, and Authelia's admin
# password from setup.sh); change it later in the web UI or with users.sh.
# Once you've signed in, keep it elsewhere and empty it here.
OC_ADMIN_PASSWORD=
# The admin's e-mail address (Authelia sends the admin's one-time codes there)
ADMIN_EMAIL=

# The versions tested together (versions.env in oc-custom)
OC_IMAGE=ghcr.io/kovacsakos14/oc-custom:7.2.4-8
AUTHELIA_IMAGE=authelia/authelia:4.39.28@sha256:bd97cff4fcbf715b5ff1f9ae286afbe6033afce385302520b0368122d43a6f54

# Sign-in with 2FA through Authelia: keep this line. Without Authelia
# (OpenCloud's built-in sign-in), remove it.
COMPOSE_FILE=compose.yaml:compose.authelia.yaml

# The Docker network SWAG is on (docker network ls)
SWAG_NETWORK=swag

# Lets an admin's app token make app tokens for other users (impersonation),
# for management tools that act as a user. It gives that token every user's
# files, so leave it empty unless a tool needs it; true turns it on.
AUTH_APP_ENABLE_IMPERSONATION=

# Owner of config/, data/, branding/ and authelia/: setup.sh fills these in
# with the user that runs it
PUID=
PGID=

# E-mail for Authelia's one-time codes and OpenCloud's share e-mails. Empty
# SMTP_HOST: no e-mails; Authelia writes its codes to
# authelia/data/notification.txt instead.
SMTP_HOST=
SMTP_PORT=587
# starttls (usually port 587), ssltls (465) or none. none sends everything,
# the password too, in plain text: only for a mail server on this host or
# network. setup.sh and Authelia refuse any other value.
SMTP_ENCRYPTION=starttls
SMTP_SENDER="OpenCloud <noreply@example.com>"
SMTP_USERNAME=
SMTP_PASSWORD=
# OpenCloud only: auto, plain, login, crammd5 or none (Authelia picks its own)
SMTP_AUTHENTICATION=auto
