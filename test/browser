#!/usr/bin/env bash
# Runs test/browser.js against the test env's OpenCloud: signs in as each user
# in a fresh browser profile and records the sign-in page and where they land.
#   test/browser OUT_DIR admin:password dave:password
set -euo pipefail

here="$(cd "$(dirname "$0")" && pwd)"
out="$(mkdir -p "$1" && cd "$1" && pwd)"
shift
docker run --rm --network host -u "$(id -u):$(id -g)" -v "$here:/usr/src/app/t:ro" -v "$out:/out" \
    -e BASE="${BASE:-https://localhost:9200}" -e USERS="$*" \
    zenika/alpine-chrome:with-puppeteer node /usr/src/app/t/browser.js
