#!/usr/bin/env bash
# Switches the test environment's OpenCloud to an oc-custom image, or to
# upstream's image of the same version.
#   test/use-custom ghcr.io/kovacsakos14/oc-custom:test-abc1234 [branding dir]
#   test/use-custom --official
# The branding dir defaults to branding/example. TEST_COMPOSE in
# test/local.env names the test environment.
set -euo pipefail

# shellcheck source=lib.sh
source "$(cd "$(dirname "$0")" && pwd)/lib.sh"
[ $# -ge 1 ] || { sed -n '2,7p' "$0" >&2; exit 2; }
[ "${#TEST_COMPOSE[@]}" -gt 0 ] 2>/dev/null || need TEST_COMPOSE

if [ "$1" = "--official" ]; then
    # Upstream's image of our version, with an empty branding folder
    export OC_CUSTOM_IMAGE="opencloudeu/opencloud:$(sed -n 's/^OC_VERSION=v//p' "$repo/versions.env")"
    export OC_CUSTOM_BRANDING="$repo/out/no-branding"
    mkdir -p "$OC_CUSTOM_BRANDING"
else
    export OC_CUSTOM_IMAGE="$1"
    OC_CUSTOM_BRANDING="$(cd "${2:-$repo/branding/example}" && pwd)"
    export OC_CUSTOM_BRANDING
fi
docker pull -q "$OC_CUSTOM_IMAGE" >/dev/null 2>&1 || true # a local image needs no pull
"${TEST_COMPOSE[@]}" -f "$repo/test/compose.override.yml" up -d opencloud
