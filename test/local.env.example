# Settings for the test helpers, describing your own OpenCloud test
# environment. Copy to test/local.env (gitignored); bash sources it.

# The docker compose command of the test environment, without a subcommand.
# Its OpenCloud service must be called "opencloud".
TEST_COMPOSE=(docker compose -f /path/to/test-env/compose.yaml)
# The test OpenCloud and an admin app token for it (auth-app with
# impersonation on: AUTH_APP_ENABLE_IMPERSONATION=true)
OC_URL=https://localhost:9200
OC_ADMIN_TOKEN=
