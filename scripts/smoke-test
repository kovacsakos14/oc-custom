#!/usr/bin/env bash
# Starts an image with a fresh config and the example branding, and checks that
# OpenCloud answers, reports the expected version, and serves the branding.
#   scripts/smoke-test oc-custom:7.2.4-1
set -euo pipefail

repo="$(cd "$(dirname "$0")/.." && pwd)"
# shellcheck source=../versions.env
source "$repo/versions.env"
image="$1"
name="oc-custom-smoke-$$"
port="${SMOKE_PORT:-9299}"
trap 'docker rm -f "$name" >/dev/null 2>&1 || true' EXIT

docker run -d --name "$name" -p "127.0.0.1:$port:9200" \
    -e OC_URL="https://localhost:$port" -e OC_INSECURE=true -e PROXY_HTTP_ADDR=0.0.0.0:9200 -e PROXY_ENABLE_BASIC_AUTH=true \
    -v "$repo/branding/example:/var/lib/opencloud/web/assets/themes/_branding:ro" \
    --entrypoint sh "$image" -c 'opencloud init --insecure true --admin-password smoke-test >/dev/null && exec opencloud server' >/dev/null

url="https://localhost:$port"
echo -n "Waiting for OpenCloud"
for _ in $(seq 60); do
    curl -fsk "$url/status.php" >/dev/null 2>&1 && break
    echo -n .; sleep 5
done
echo
fail() { echo "FAIL: $*" >&2; docker logs --tail 30 "$name" >&2; exit 1; }

status="$(curl -fsk "$url/status.php")" || fail "status.php doesn't answer"
want="${OC_VERSION#v}+custom.$BUILD"
grep -q "\"productversion\": *\"$want\"" <<<"$status" || fail "expected version $want in $status"
echo "ok  version $want"

theme="$(curl -fsk "$url/themes/opencloud/theme.json")" || fail "no theme.json"
grep -q '"name":"Acme Files"' <<<"$theme" || fail "the branding's name isn't in theme.json"
# Responses are read whole first: grep -q stops early, and under pipefail
# curl's broken pipe would count as a failure
logo="$(curl -fsk "$url/themes/_branding/logo.svg")" || fail "the branding's logo isn't served"
grep -q '<svg' <<<"$logo" || fail "the branding's logo isn't an SVG"
grep -q '"backgroundImage":"themes/_branding/background.jpg"' <<<"$theme" || fail "the sign-in background key isn't in theme.json"
curl -fsk -o /dev/null "$url/themes/_branding/background.jpg" || fail "the sign-in background image isn't served"
echo "ok  branding"

page="$(curl -fsk "$url/")" || fail "the web UI doesn't answer"
grep -qi '<html' <<<"$page" || fail "the web UI isn't served: ${page:0:200}"
echo "ok  web UI"

apps="$(curl -fsk -u admin:smoke-test "$url/graph/v1.0/applications")" || fail "Graph's applications don't answer"
for type in Client Employee "User Light" Admin; do
    grep -q "\"displayName\":\"$type\"" <<<"$apps" || fail "no user type $type in $apps"
done
echo "ok  user types"

roles="$(curl -fsk -u admin:smoke-test "$url/graph/v1beta1/roleManagement/permissions/roleDefinitions")" || fail "Graph's share roles don't answer"
grep -q '"id":"a61a37ad-42f2-46f6-a047-fe1906b525e2"' <<<"$roles" || fail "the share role \"Can't delete\" isn't offered"
grep -Eq '"a61a37ad-42f2-46f6-a047-fe1906b525e2":\{[^}]*"iconName":"folder-shield-2"' <<<"$theme" || fail "the share role \"Can't delete\" has no icon in theme.json"
echo "ok  share role"

caps="$(curl -fsk -u admin:smoke-test "$url/ocs/v1.php/cloud/capabilities?format=json")" || fail "no capabilities"
grep -Eq '"support-radicale": ?false' <<<"$caps" || fail "Calendar isn't off by default"
grep -Eq '"notifications": ?\{[^}]*"configurable": ?true' <<<"$caps" || fail "notifications aren't configurable by default"
webconf="$(curl -fsk "$url/config.json")" || fail "the web's config.json doesn't answer"
grep -Eq '"disableFeedbackLink": ?true' <<<"$webconf" || fail "the feedback button isn't off by default"
echo "ok  image defaults"
