#!/usr/bin/env bash
# Builds the patched OpenCloud binary (amd64) with the patched web embedded,
# the management API (manage-api/), then the image. Every step runs in a container with upstream's toolchain, so
# only Docker is needed. Needs about 8 GB of RAM: run it in CI (GitHub Actions)
# or on a strong machine, not on a small VM.
#   scripts/build-native [image tag]     # default: oc-custom:<version>-<build>
# Caches (pnpm store, Go modules and build cache) live in $OC_CUSTOM_CACHE
# (default ~/.cache/oc-custom); CI keeps them between runs.
set -euo pipefail

repo="$(cd "$(dirname "$0")/.." && pwd)"
# shellcheck source=../versions.env
source "$repo/versions.env"
tag="${1:-oc-custom:${OC_VERSION#v}-$BUILD}"
cache="${OC_CUSTOM_CACHE:-$HOME/.cache/oc-custom}"
up="$repo/upstream"
mkdir -p "$cache"/{pnpm,go-mod,go-build} "$repo/out"

# Pinned by digest like the others: it builds the web that goes into the binary
NODE_IMAGE=node:24-alpine@sha256:6a1c190e17215d844926b0677f4bf87273ff7d5e54db06d3b5b5863ab0b09a3d # Node 24.22.1
NODE_CI_IMAGE=quay.io/opencloudeu/nodejs-ci:24@sha256:4133e457d46874781ab84cf74b61055eec921b486c44eb2e8881a80ca171cd1a
GO_CI_IMAGE=quay.io/opencloudeu/golang-ci:1.25@sha256:49ec402d6bdf36211306b7bdb2830555c9365dfa3cb12f833604fc742871fef5

run() { # image, workdir (under upstream/), command
    docker run --rm -u "$(id -u):$(id -g)" -e HOME=/tmp \
        -e COREPACK_HOME=/cache/pnpm/corepack -e COREPACK_ENABLE_DOWNLOAD_PROMPT=0 \
        -e npm_config_store_dir=/cache/pnpm/store \
        -e GOMODCACHE=/cache/go-mod -e GOCACHE=/cache/go-build -e GOFLAGS=-buildvcs=false \
        -v "$cache:/cache" -v "$up:/src" -w "/src/$2" "$1" sh -euc "$3"
}

"$repo/scripts/fetch"
"$repo/scripts/apply"
"$repo/scripts/check-upstream"

# 1. The patched web, as upstream packages it (Makefile.release: build + copy-config),
# kept in out/web-dist. Skipped when that was built from the same version,
# patches and toolchain (node image, pnpm) (CI restores it from its cache).
web_key="$WEB_VERSION-$({ printf '%s\n' "$NODE_IMAGE" "$PNPM_VERSION" "$PNPM_SHA512"
    cat "$repo"/patches/web/*.patch; } | sha256sum | cut -c1-16)"
web_dist="$repo/out/web-dist"
if [ "$(cat "$web_dist/.oc-custom-key" 2>/dev/null)" = "$web_key" ]; then
    echo "web: out/web-dist is up to date ($web_key)"
else
    # corepack checks the pnpm it downloads against the hash in packageManager;
    # upstream names the version only, so the hash is added for the build
    pkg="$up/web/package.json"
    grep -q "\"packageManager\": \"pnpm@$PNPM_VERSION\"" "$pkg" ||
        { echo "web: package.json doesn't pin pnpm@$PNPM_VERSION; update PNPM_VERSION and PNPM_SHA512 in versions.env" >&2; exit 1; }
    sed -i "s/\"packageManager\": \"pnpm@$PNPM_VERSION\"/\"packageManager\": \"pnpm@$PNPM_VERSION+sha512.$PNPM_SHA512\"/" "$pkg"
    trap 'git -C "$up/web" checkout -q -- package.json' EXIT
    run "$NODE_IMAGE" web 'mkdir -p /tmp/bin && corepack enable --install-directory /tmp/bin && export PATH=/tmp/bin:$PATH &&
        pnpm install --frozen-lockfile && pnpm build && cp config/config.json.dist dist/'
    git -C "$up/web" checkout -q -- package.json
    trap - EXIT
    rm -rf "$web_dist"
    cp -r "$up/web/dist" "$web_dist"
    echo "$web_key" > "$web_dist/.oc-custom-key"
fi

# 2. The server: the reva patches in its vendored reva (the same version, see
# versions.env; vendor/ has no tests), the IDP's frontend (the only other
# node-generate step), our web in place of the downloaded one, then the same
# target the official image uses.
vendored=vendor/github.com/opencloud-eu/reva/v2
for p in "$repo"/patches/reva/*.patch; do
    [ -e "$p" ] || continue
    if git -C "$up/server" apply --directory="$vendored" --exclude='*_test.go' --reverse --check "$p" 2>/dev/null; then
        echo "reva/$(basename "$p"): already in the vendored reva"
    else
        git -C "$up/server" apply --directory="$vendored" --exclude='*_test.go' "$p"
        echo "reva/$(basename "$p"): applied to the vendored reva"
    fi
done
run "$NODE_CI_IMAGE" server/services/idp 'make node-generate-prod'
rm -rf "$up/server/services/web/assets/core"
mkdir -p "$up/server/services/web/assets/core"
cp -r "$web_dist/." "$up/server/services/web/assets/core/"
rm -f "$up/server/services/web/assets/core/.oc-custom-key"
run "$GO_CI_IMAGE" server "make go-generate &&
    make -C opencloud release-linux-docker-amd64 ENABLE_VIPS=true DIST=/src/server/dist \
        VERSION=$OC_VERSION STRING=custom.$BUILD EDITION=stable"
cp "$up/server/dist/binaries/opencloud-linux-amd64" "$repo/out/opencloud"

# 3. The management API (manage-api/, tested first) and Authelia's CLI for it
docker run --rm -u "$(id -u):$(id -g)" -e HOME=/tmp -e GOMODCACHE=/cache/go-mod -e GOCACHE=/cache/go-build \
    -e GOFLAGS=-buildvcs=false -e CGO_ENABLED=0 -v "$cache:/cache" -v "$repo/manage-api:/src" -v "$repo/out:/out" \
    -w /src "$GO_CI_IMAGE" sh -euc 'go vet ./... && go test ./... && go build -trimpath -ldflags=-s -o /out/manage-api .'
curl -fsSL -o "$repo/out/authelia.tar.gz" "$AUTHELIA_MUSL_URL"
echo "$AUTHELIA_MUSL_SHA256  $repo/out/authelia.tar.gz" | sha256sum -c --quiet
tar xzf "$repo/out/authelia.tar.gz" -C "$repo/out" authelia
rm "$repo/out/authelia.tar.gz"

# 4. The image: the official one with our binaries
docker build --build-arg "BASE_IMAGE=$BASE_IMAGE" -t "$tag" "$repo"
docker run --rm --entrypoint sh "$tag" -c 'opencloud version | head -2 && ! ldd /usr/bin/opencloud | grep "not found" &&
    authelia --version && manage-api new-token > /dev/null &&
    d=$(echo pw | manage-api hash-password) && authelia crypto hash validate --password pw -- "$d" | grep -q "password matches"'
echo "Built $tag"
