# Upstream versions this build is based on. The reva and web versions are the
# ones the server tag pins (go.mod, services/web/Makefile WEB_ASSETS_VERSION).
OC_VERSION=v7.2.4
REVA_VERSION=v2.46.8
WEB_VERSION=v7.1.5
# pnpm as the web pins it (package.json packageManager), with the sha512 (hex)
# of its npm tarball, so corepack checks what it downloads
# (npm view pnpm@<version> dist.integrity, base64 -> hex)
PNPM_VERSION=11.5.2
PNPM_SHA512=71c631e382066efc25625d5cf029075de07b61b37f6e27350fbd84b1bda5864c8c1967adc280776b45c30a715c0359a3be08fef42d5bb09e2b99029979692916
# Official image the custom binary is copied into
BASE_IMAGE=opencloudeu/opencloud:7.2.4@sha256:6d992ccc5f1cbc7b2a9b272ba25f879b1b159c2d7ed7f5527e09059f16295697
# Our build number for this OpenCloud version: image tag 7.2.4-<BUILD>
BUILD=13
# The Authelia version this build is tested with (deploy/, test/deploy/run.sh);
# deploy/.env.example names the same one
AUTHELIA_IMAGE=authelia/authelia:4.39.28@sha256:bd97cff4fcbf715b5ff1f9ae286afbe6033afce385302520b0368122d43a6f54
# Authelia's own musl build of that version, for the management API in the
# image (the Authelia image's binary needs glibc; ours is Alpine): the release
# asset and its sha256
AUTHELIA_MUSL_URL=https://github.com/authelia/authelia/releases/download/v4.39.28/authelia-v4.39.28-linux-amd64-musl.tar.gz
AUTHELIA_MUSL_SHA256=ce2526b633ce3eec06680fae2f26060dc8cef3a92cdbc376410b28bcca6c97e1
