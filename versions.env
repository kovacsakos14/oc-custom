# Upstream versions this build is based on. The reva and web versions are the
# ones the server tag pins (go.mod, services/web/Makefile WEB_ASSETS_VERSION).
OC_VERSION=v7.2.4
REVA_VERSION=v2.46.8
WEB_VERSION=v7.1.5
# Official image the custom binary is copied into
BASE_IMAGE=opencloudeu/opencloud:7.2.4@sha256:6d992ccc5f1cbc7b2a9b272ba25f879b1b159c2d7ed7f5527e09059f16295697
# Our build number for this OpenCloud version: image tag 7.2.4-<BUILD>
BUILD=1
