@@ -0,0 +1,43 @@
+package conversions
+
+// oc-custom: tests for the oc-custom change in WebDAVPermissions, in their own
+// file so the patch doesn't conflict with upstream changes to role_test.go.
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+)
+
+// cantDelete is oc-custom's "Can't delete" share role: "Can upload" plus GetQuota
+func cantDelete() *Role {
+	p := NewEditorLiteRole().CS3ResourcePermissions()
+	p.GetQuota = true
+	return RoleFromResourcePermissions(p, false)
+}
+
+func TestWebDAVPermissionsCantDelete(t *testing.T) {
+	// a user share: rename/move, create in folders, no write or delete
+	assert.Equal(t, "SNVCK", cantDelete().WebDAVPermissions(true, true, false, false))
+	assert.Equal(t, "SNV", cantDelete().WebDAVPermissions(false, true, false, false))
+	assert.Equal(t, "NV", cantDelete().WebDAVPermissions(false, false, false, false))
+}
+
+func TestWebDAVPermissionsUpstreamUnchanged(t *testing.T) {
+	// upstream's "Can upload" reports upstream's letters again
+	editorLite := RoleFromResourcePermissions(NewEditorLiteRole().CS3ResourcePermissions(), false)
+	assert.Equal(t, RoleEditorLite, editorLite.Name)
+	assert.Equal(t, "SCK", editorLite.WebDAVPermissions(true, true, false, false))
+	assert.Equal(t, "S", editorLite.WebDAVPermissions(false, true, false, false))
+	// public links: unchanged
+	editorLiteLink := RoleFromResourcePermissions(NewEditorLiteRole().CS3ResourcePermissions(), true)
+	assert.Equal(t, "CK", editorLiteLink.WebDAVPermissions(true, false, false, true))
+	assert.Equal(t, "", editorLiteLink.WebDAVPermissions(false, false, false, true))
+	// roles without move or with write: unchanged
+	uploader := RoleFromResourcePermissions(NewUploaderRole().CS3ResourcePermissions(), false)
+	assert.Equal(t, "SCK", uploader.WebDAVPermissions(true, true, false, false))
+	viewer := RoleFromResourcePermissions(NewViewerRole().CS3ResourcePermissions(), false)
+	assert.NotContains(t, viewer.WebDAVPermissions(true, true, false, false), "N")
+	editor := RoleFromResourcePermissions(NewEditorRole().CS3ResourcePermissions(), false)
+	assert.Equal(t, "SDNVCK", editor.WebDAVPermissions(true, true, false, false))
+}
