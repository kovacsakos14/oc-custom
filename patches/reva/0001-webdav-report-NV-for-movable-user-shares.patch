+
+func TestWebDAVPermissionsMoveWithoutWrite(t *testing.T) {
+	editorLite := RoleFromResourcePermissions(NewEditorLiteRole().CS3ResourcePermissions(), false)
+	assert.Equal(t, RoleEditorLite, editorLite.Name)
+	// a user share: rename/move, create in folders, no write or delete
+	assert.Equal(t, "SNVCK", editorLite.WebDAVPermissions(true, true, false, false))
+	assert.Equal(t, "SNV", editorLite.WebDAVPermissions(false, true, false, false))
+	// the same role through a public link: unchanged
+	editorLiteLink := RoleFromResourcePermissions(NewEditorLiteRole().CS3ResourcePermissions(), true)
+	assert.Equal(t, "CK", editorLiteLink.WebDAVPermissions(true, false, false, true))
+	assert.Equal(t, "", editorLiteLink.WebDAVPermissions(false, false, false, true))
+
+	// roles without move are unchanged
+	uploader := RoleFromResourcePermissions(NewUploaderRole().CS3ResourcePermissions(), false)
+	assert.Equal(t, "SCK", uploader.WebDAVPermissions(true, true, false, false))
+	viewer := RoleFromResourcePermissions(NewViewerRole().CS3ResourcePermissions(), false)
+	assert.NotContains(t, viewer.WebDAVPermissions(true, true, false, false), "N")
+}
