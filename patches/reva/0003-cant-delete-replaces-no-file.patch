diff --git a/pkg/storage/pkg/decomposedfs/upload_custom.go b/pkg/storage/pkg/decomposedfs/upload_custom.go
new file mode 100644
index 0000000..0383570
--- /dev/null
+++ b/pkg/storage/pkg/decomposedfs/upload_custom.go
@@ -0,0 +1,68 @@
+package decomposedfs
+
+// oc-custom: oc-custom's "Can't delete" share role may upload new files but not
+// replace one that has content, so nothing on such a share can be lost: an upload
+// over an existing file (PUT, TUS, COPY onto it) is refused. Two uploads lose
+// nothing and are accepted: over an empty file (Windows Explorer and macOS Finder
+// create a file empty first and then upload its content over it), and of the same
+// content (a client retrying an upload whose answer it never got). Upstream's
+// roles keep their behaviour.
+
+import (
+	"context"
+	"encoding/hex"
+	"strings"
+
+	provider "github.com/cs3org/go-cs3apis/cs3/storage/provider/v1beta1"
+	"github.com/opencloud-eu/reva/v2/pkg/storage/pkg/decomposedfs/metadata/prefixes"
+	"github.com/opencloud-eu/reva/v2/pkg/storage/pkg/decomposedfs/node"
+)
+
+// isCantDelete tells oc-custom's "Can't delete" role (upstream's "Can upload" plus
+// GetQuota) by its permissions: upload and move, no delete, no write (reva writes
+// W for InitiateFileUpload with RestoreRecycleItem). The same set gets NV in
+// conversions.Role.WebDAVPermissions.
+func isCantDelete(rp *provider.ResourcePermissions) bool {
+	return rp.GetInitiateFileUpload() && rp.GetMove() && rp.GetGetQuota() &&
+		!rp.GetDelete() && !rp.GetRestoreRecycleItem()
+}
+
+// mayReplace tells whether an upload may replace the existing file n. checksum is
+// the one the client declared ("sha1 <hex>", as ocdav passes OC-Checksum and TUS
+// Upload-Metadata on), or "".
+func mayReplace(ctx context.Context, rp *provider.ResourcePermissions, n *node.Node, checksum string) bool {
+	return n.Blobsize == 0 || !isCantDelete(rp) || sameContent(ctx, n, checksum)
+}
+
+// sameContent tells whether the declared checksum is the file's own. The upload is
+// checked against the declared checksum when it finishes (FinishUploadDecomposed,
+// before it replaces anything; the posix driver uses the same sessions), so new
+// content can't pass for the old. Only SHA-1 and MD5: content with a given Adler-32
+// is easy to make.
+func sameContent(ctx context.Context, n *node.Node, checksum string) bool {
+	algorithm, sum, ok := strings.Cut(checksum, " ")
+	if !ok || sum == "" || (algorithm != "sha1" && algorithm != "md5") {
+		return false
+	}
+	stored, err := n.Xattr(ctx, prefixes.ChecksumPrefix+algorithm)
+	return err == nil && len(stored) > 0 && hex.EncodeToString(stored) == sum
+}
+
+// pinToCurrent makes the upload replace only the file as it is now: reva checks
+// the session's If-Match against the file's etag when the upload finishes
+// (updateExistingNode), and InitiateUpload's check alone would let an upload
+// started over an empty file replace content written there in between (sessions
+// live a day). Always set, also over a client's own If-Match: the storage provider
+// has already checked that one against the current etag.
+func pinToCurrent(ctx context.Context, session interface{ SetMetadata(key, value string) }, n *node.Node) error {
+	mtime, err := n.GetMTime(ctx)
+	if err != nil {
+		return err
+	}
+	etag, err := node.CalculateEtag(n.ID, mtime)
+	if err != nil {
+		return err
+	}
+	session.SetMetadata("if-match", etag)
+	return nil
+}
diff --git a/pkg/storage/pkg/decomposedfs/upload_custom_test.go b/pkg/storage/pkg/decomposedfs/upload_custom_test.go
new file mode 100644
index 0000000..4d78474
--- /dev/null
+++ b/pkg/storage/pkg/decomposedfs/upload_custom_test.go
@@ -0,0 +1,157 @@
+package decomposedfs_test
+
+// oc-custom: tests for the oc-custom change in InitiateUpload (upload_custom.go),
+// in their own file so the patch doesn't conflict with upstream changes to
+// upload_test.go.
+
+import (
+	"bytes"
+	"crypto/md5"
+	"crypto/sha1"
+	"encoding/hex"
+	"hash/adler32"
+	"io"
+
+	provider "github.com/cs3org/go-cs3apis/cs3/storage/provider/v1beta1"
+	. "github.com/onsi/ginkgo/v2"
+	. "github.com/onsi/gomega"
+	"github.com/opencloud-eu/reva/v2/pkg/conversions"
+	"github.com/opencloud-eu/reva/v2/pkg/errtypes"
+	"github.com/opencloud-eu/reva/v2/pkg/storage"
+	"github.com/opencloud-eu/reva/v2/pkg/storage/pkg/decomposedfs/metadata/prefixes"
+	helpers "github.com/opencloud-eu/reva/v2/pkg/storage/pkg/decomposedfs/testhelpers"
+	"github.com/stretchr/testify/mock"
+)
+
+var _ = Describe("Uploads on oc-custom's Can't delete role", func() {
+	var env *helpers.DecomposedTestEnv
+
+	cantDelete := func() *provider.ResourcePermissions {
+		p := conversions.NewEditorLiteRole().CS3ResourcePermissions()
+		p.GetQuota = true
+		return p
+	}
+	canUpload := func() *provider.ResourcePermissions { return conversions.NewEditorLiteRole().CS3ResourcePermissions() }
+	canEdit := func() *provider.ResourcePermissions { return conversions.NewEditorRole().CS3ResourcePermissions() }
+
+	ref := func(name string) *provider.Reference {
+		return &provider.Reference{ResourceId: env.SpaceRootRes, Path: "./dir1/" + name}
+	}
+	// initiate starts an upload of 10 bytes to name with the given permissions and
+	// upload metadata
+	initiate := func(perms *provider.ResourcePermissions, name string, metadata map[string]string) (map[string]string, error) {
+		// replaces the test env's own answer (its owner's permissions)
+		env.Permissions.ExpectedCalls = nil
+		env.Permissions.On("AssemblePermissions", mock.Anything, mock.Anything).Return(perms, nil)
+		return env.Fs.InitiateUpload(env.Ctx, ref(name), 10, metadata)
+	}
+	uploadWith := func(perms *provider.ResourcePermissions, name string, metadata map[string]string) error {
+		_, err := initiate(perms, name, metadata)
+		return err
+	}
+	upload := func(perms *provider.ResourcePermissions, name string) error {
+		return uploadWith(perms, name, map[string]string{})
+	}
+
+	// full.txt's content, and its checksums as the storage keeps them
+	content := []byte("0123456789")
+	sha1Sum, md5Sum := sha1.Sum(content), md5.Sum(content)
+	adler32Sum := adler32.New()
+	_, _ = adler32Sum.Write(content)
+	checksum := func(algorithm string, sum []byte) map[string]string {
+		return map[string]string{"checksum": algorithm + " " + hex.EncodeToString(sum)}
+	}
+
+	BeforeEach(func() {
+		var err error
+		env, err = helpers.NewTestEnv(nil)
+		Expect(err).ToNot(HaveOccurred())
+		dir1, err := env.Lookup.NodeFromResource(env.Ctx, &provider.Reference{ResourceId: env.SpaceRootRes, Path: "./dir1"})
+		Expect(err).ToNot(HaveOccurred())
+		full, err := env.CreateTestFile("full.txt", "full-blobid", dir1.ID, dir1.SpaceID, 10)
+		Expect(err).ToNot(HaveOccurred())
+		Expect(full.SetXattr(env.Ctx, prefixes.ChecksumPrefix+"sha1", sha1Sum[:])).To(Succeed())
+		Expect(full.SetXattr(env.Ctx, prefixes.ChecksumPrefix+"md5", md5Sum[:])).To(Succeed())
+		Expect(full.SetXattr(env.Ctx, prefixes.ChecksumPrefix+"adler32", adler32Sum.Sum(nil))).To(Succeed())
+		_, err = env.CreateTestFile("empty.txt", "", dir1.ID, dir1.SpaceID, 0)
+		Expect(err).ToNot(HaveOccurred())
+	})
+
+	AfterEach(func() {
+		if env != nil {
+			env.Cleanup()
+		}
+	})
+
+	It("refuses replacing a file that has content", func() {
+		Expect(upload(cantDelete(), "full.txt")).To(BeAssignableToTypeOf(errtypes.PermissionDenied("")))
+	})
+	It("accepts a new file", func() {
+		Expect(upload(cantDelete(), "new.txt")).To(Succeed())
+	})
+	It("accepts replacing an empty file (Windows Explorer and macOS Finder create files empty first)", func() {
+		Expect(upload(cantDelete(), "empty.txt")).To(Succeed())
+	})
+	It("accepts the same content again (a client retrying an upload whose answer it never got)", func() {
+		Expect(uploadWith(cantDelete(), "full.txt", checksum("sha1", sha1Sum[:]))).To(Succeed())
+		Expect(uploadWith(cantDelete(), "full.txt", checksum("md5", md5Sum[:]))).To(Succeed())
+	})
+	It("refuses other content, and doesn't trust Adler-32 (easy to forge)", func() {
+		other := sha1.Sum([]byte("something else"))
+		Expect(uploadWith(cantDelete(), "full.txt", checksum("sha1", other[:]))).To(BeAssignableToTypeOf(errtypes.PermissionDenied("")))
+		Expect(uploadWith(cantDelete(), "full.txt", checksum("adler32", adler32Sum.Sum(nil)))).To(BeAssignableToTypeOf(errtypes.PermissionDenied("")))
+	})
+	It("leaves upstream's Can upload and Can edit as they are", func() {
+		Expect(upload(canUpload(), "full.txt")).To(Succeed())
+		Expect(upload(canEdit(), "full.txt")).To(Succeed())
+	})
+
+	// finishAfter starts an upload of content to name as perms (with the upload
+	// metadata), runs between (the owner, while the upload is open), then sends
+	// the content, which finishes the upload
+	finishAfter := func(perms *provider.ResourcePermissions, name string, metadata map[string]string, between func()) error {
+		ids, err := initiate(perms, name, metadata)
+		Expect(err).ToNot(HaveOccurred())
+		between()
+		env.Blobstore.On("Upload", mock.Anything, mock.Anything, mock.Anything).Return(nil)
+		_, err = env.Fs.Upload(env.Ctx, storage.UploadRequest{
+			Ref:    &provider.Reference{Path: "/" + ids["simple"]},
+			Body:   io.NopCloser(bytes.NewReader(content)),
+			Length: int64(len(content)),
+		}, nil)
+		return err
+	}
+	// changed: the owner uploads other content to name (with upstream's Can edit)
+	changed := func(name string) func() {
+		return func() {
+			ids, err := initiate(canEdit(), name, map[string]string{})
+			Expect(err).ToNot(HaveOccurred())
+			env.Blobstore.On("Upload", mock.Anything, mock.Anything, mock.Anything).Return(nil)
+			other := []byte("the owner!") // 10 bytes, as initiate declares
+			_, err = env.Fs.Upload(env.Ctx, storage.UploadRequest{
+				Ref:    &provider.Reference{Path: "/" + ids["simple"]},
+				Body:   io.NopCloser(bytes.NewReader(other)),
+				Length: int64(len(other)),
+			}, nil)
+			Expect(err).ToNot(HaveOccurred())
+		}
+	}
+	unchanged := func() {}
+
+	It("refuses finishing over an empty file that changed since the upload started", func() {
+		Expect(finishAfter(cantDelete(), "empty.txt", nil, changed("empty.txt"))).To(BeAssignableToTypeOf(errtypes.Aborted("")))
+		n, err := env.Lookup.NodeFromResource(env.Ctx, ref("empty.txt"))
+		Expect(err).ToNot(HaveOccurred())
+		Expect(n.Blobsize).To(Equal(int64(len("the owner!"))))
+	})
+	It("refuses finishing the same content over a file that changed since the upload started", func() {
+		Expect(finishAfter(cantDelete(), "full.txt", checksum("sha1", sha1Sum[:]), changed("full.txt"))).
+			To(BeAssignableToTypeOf(errtypes.Aborted("")))
+	})
+	It("finishes over an empty file that didn't change", func() {
+		Expect(finishAfter(cantDelete(), "empty.txt", nil, unchanged)).To(Succeed())
+	})
+	It("doesn't pin upstream's Can edit", func() {
+		Expect(finishAfter(canEdit(), "full.txt", nil, changed("full.txt"))).To(Succeed())
+	})
+})
