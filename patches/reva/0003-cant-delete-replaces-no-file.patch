diff --git a/pkg/storage/utils/decomposedfs/upload_custom.go b/pkg/storage/utils/decomposedfs/upload_custom.go
new file mode 100644
index 0000000..cfcc45a
--- /dev/null
+++ b/pkg/storage/utils/decomposedfs/upload_custom.go
@@ -0,0 +1,26 @@
+package decomposedfs
+
+// oc-custom: oc-custom's "Can't delete" share role may upload new files but not
+// replace one that has content, so nothing on such a share can be lost: an upload
+// over an existing file (PUT, TUS, COPY onto it) is refused. An empty file may be
+// replaced, since nothing is lost that way: Windows Explorer and macOS Finder
+// create a file empty first and then upload its content over it. Upstream's roles
+// keep their behaviour.
+
+import (
+	provider "github.com/cs3org/go-cs3apis/cs3/storage/provider/v1beta1"
+)
+
+// isCantDelete tells oc-custom's "Can't delete" role (upstream's "Can upload" plus
+// GetQuota) by its permissions: upload and move, no delete, no write (reva writes
+// W for InitiateFileUpload with RestoreRecycleItem). The same set gets NV in
+// conversions.Role.WebDAVPermissions.
+func isCantDelete(rp *provider.ResourcePermissions) bool {
+	return rp.GetInitiateFileUpload() && rp.GetMove() && rp.GetGetQuota() &&
+		!rp.GetDelete() && !rp.GetRestoreRecycleItem()
+}
+
+// mayReplace tells whether an upload may replace an existing file of the given size
+func mayReplace(rp *provider.ResourcePermissions, size int64) bool {
+	return size == 0 || !isCantDelete(rp)
+}
