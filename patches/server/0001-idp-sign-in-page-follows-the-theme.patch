diff --git a/services/idp/src/branding.js b/services/idp/src/branding.js
new file mode 100644
index 00000000..2cd164a2
--- /dev/null
+++ b/services/idp/src/branding.js
@@ -0,0 +1,69 @@
+// oc-custom: lets the sign-in page follow the instance's theme (theme.json,
+// including themes/_branding). Without branding everything stays as upstream:
+// the CSS variables default to the original colours in app.css.
+//
+//   common.name                      the tab title: "Sign in - <name>"
+//   clients.web.defaults.favicon     the tab icon
+//   common.signin.background         the page background
+//   common.signin.accent             the button, the input focus ring, the hexagon
+//   common.signin.onAccent           the button's text
+//   common.signin.footer             the footer text ("" hides it)
+//   common.signin.backgroundImage    a background picture, instead of the
+//                                    hexagon (IDP_LOGIN_BACKGROUND_URL wins)
+
+const colorVariables = {
+  background: '--oc-signin-background',
+  accent: '--oc-signin-accent',
+  onAccent: '--oc-signin-on-accent'
+};
+
+// Only plain colour values: the theme is admin-controlled, but it ends up in CSS
+const colorPattern = /^(#[0-9a-fA-F]{3,8}|(rgb|rgba|hsl|hsla)\([0-9.,%\s]+\)|[a-zA-Z]+)$/;
+
+export function applyBranding(theme) {
+  const name = theme?.common?.name;
+  if (name) {
+    document.title = `Sign in - ${name}`;
+  }
+
+  const favicon = theme?.clients?.web?.defaults?.favicon;
+  const icon = document.querySelector('link[rel~="icon"]');
+  if (favicon && icon) {
+    icon.setAttribute('href', '/' + favicon.replace(/^\/+/, ''));
+    icon.removeAttribute('type');
+  }
+
+  const signin = theme?.common?.signin || {};
+  for (const [key, variable] of Object.entries(colorVariables)) {
+    const value = signin[key];
+    if (typeof value === 'string' && colorPattern.test(value.trim())) {
+      document.documentElement.style.setProperty(variable, value.trim());
+    }
+  }
+}
+
+// The footer text from the theme, or undefined to keep upstream's
+export function signinFooter(theme) {
+  const footer = theme?.common?.signin?.footer;
+  return typeof footer === 'string' ? footer : undefined;
+}
+
+// Only plain paths or https URLs: the value ends up in a CSS url()
+const imagePathPattern = /^[\w\-./%~]+$/;
+const imageUrlPattern = /^https:\/\/[\w\-./%~:@?=&+]+$/;
+
+// The background image URL from the theme, or undefined for none
+export function signinBackgroundImage(theme) {
+  const image = theme?.common?.signin?.backgroundImage;
+  if (typeof image !== 'string' || image.trim() === '') {
+    return undefined;
+  }
+  const value = image.trim();
+  if (imageUrlPattern.test(value)) {
+    return value;
+  }
+  if (imagePathPattern.test(value) && !value.split('/').includes('..')) {
+    return '/' + value.replace(/^\/+/, '');
+  }
+  return undefined;
+}
