+package defaults
+
+// oc-custom: our user types are among the defaults, with exactly the permissions we chose.
+
+import (
+	"slices"
+	"testing"
+)
+
+func TestCustomBundlesAreDefaults(t *testing.T) {
+	ids := map[string]bool{}
+	names := map[string]bool{}
+	for _, b := range GenerateBundlesDefaultRoles() {
+		if ids[b.GetId()] || names[b.GetName()] {
+			t.Fatalf("bundle %s (%s) is not unique", b.GetName(), b.GetId())
+		}
+		ids[b.GetId()], names[b.GetName()] = true, true
+	}
+	for _, id := range []string{
+		BundleUUIDRoleAdmin, BundleUUIDRoleSpaceAdmin, BundleUUIDRoleUser, BundleUUIDRoleUserLight,
+		BundleUUIDRoleClient, BundleUUIDRoleEmployee,
+	} {
+		if !ids[id] {
+			t.Errorf("default bundles lack %s", id)
+		}
+	}
+}
+
+func TestCustomBundlePermissions(t *testing.T) {
+	want := map[string][]string{
+		BundleUUIDRoleClient: {"Language.ReadWrite"},
+		BundleUUIDRoleEmployee: {
+			"EmailNotifications.ReadWriteDisabled",
+			"EmailSendingInterval.ReadWrite",
+			"Event.ShareCreated.ReadWrite",
+			"Event.ShareRemoved.ReadWrite",
+			"Event.ShareExpired.ReadWrite",
+			"Event.SpaceShared.ReadWrite",
+			"Event.SpaceUnshared.ReadWrite",
+			"Event.SpaceMembershipExpired.ReadWrite",
+			"Event.SpaceDisabled.ReadWrite",
+			"Event.SpaceDeleted.ReadWrite",
+			"Event.PostprocessingStepFinished.ReadWrite",
+			"Language.ReadWrite",
+		},
+	}
+	for _, b := range customBundles() {
+		var got []string
+		for _, s := range b.GetSettings() {
+			got = append(got, s.GetName())
+			if c := s.GetPermissionValue().GetConstraint(); c != Own {
+				t.Errorf("%s: %s has constraint %v, want own", b.GetName(), s.GetName(), c)
+			}
+		}
+		if !slices.Equal(got, want[b.GetId()]) {
+			t.Errorf("%s: permissions %v, want %v", b.GetName(), got, want[b.GetId()])
+		}
+	}
+}
