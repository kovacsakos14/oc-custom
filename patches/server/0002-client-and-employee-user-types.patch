+package defaults
+
+// oc-custom: two user types of our own, added to upstream's default types.
+// Upstream's types stay as upstream ships them.
+
+import (
+	settingsmsg "github.com/opencloud-eu/opencloud/protogen/gen/opencloud/messages/settings/v0"
+)
+
+const (
+	// BundleUUIDRoleClient represents the client role: folders shared to them, language only.
+	BundleUUIDRoleClient = "38f0649f-b600-4188-b138-fbd2c773cc43"
+	// BundleUUIDRoleEmployee represents the employee role: folders shared to them, language and e-mail notifications.
+	BundleUUIDRoleEmployee = "12047bc6-9aa3-49f6-8d78-e64b3065cd99"
+)
+
+// customBundles returns our user types. Neither has a personal space, favourites,
+// public links, shares of their own or the auto-accept setting.
+func customBundles() []*settingsmsg.Bundle {
+	return []*settingsmsg.Bundle{
+		generateBundleClientRole(),
+		generateBundleEmployeeRole(),
+	}
+}
+
+func generateBundleClientRole() *settingsmsg.Bundle {
+	return &settingsmsg.Bundle{
+		Id:          BundleUUIDRoleClient,
+		Name:        "client",
+		Type:        settingsmsg.Bundle_TYPE_ROLE,
+		Extension:   "opencloud-roles",
+		DisplayName: "Client",
+		Resource: &settingsmsg.Resource{
+			Type: settingsmsg.Resource_TYPE_SYSTEM,
+		},
+		Settings: []*settingsmsg.Setting{
+			LanguageManagementPermission(Own),
+		},
+	}
+}
+
+func generateBundleEmployeeRole() *settingsmsg.Bundle {
+	return &settingsmsg.Bundle{
+		Id:          BundleUUIDRoleEmployee,
+		Name:        "employee",
+		Type:        settingsmsg.Bundle_TYPE_ROLE,
+		Extension:   "opencloud-roles",
+		DisplayName: "Employee",
+		Resource: &settingsmsg.Resource{
+			Type: settingsmsg.Resource_TYPE_SYSTEM,
+		},
+		Settings: []*settingsmsg.Setting{
+			DisableEmailNotificationsPermission(Own),
+			ProfileEmailSendingIntervalPermission(Own),
+			ProfileEventShareCreatedPermission(Own),
+			ProfileEventShareRemovedPermission(Own),
+			ProfileEventShareExpiredPermission(Own),
+			ProfileEventSpaceSharedPermission(Own),
+			ProfileEventSpaceUnsharedPermission(Own),
+			ProfileEventSpaceMembershipExpiredPermission(Own),
+			ProfileEventSpaceDisabledPermission(Own),
+			ProfileEventSpaceDeletedPermission(Own),
+			ProfileEventPostprocessingStepFinishedPermission(Own),
+			LanguageManagementPermission(Own),
+		},
+	}
+}
