@@ -0,0 +1,18 @@
+import { isFileEditable } from '../../../../src/components/AppTemplates/editable'
+
+// oc-custom: apps open a file for editing only with the write permission
+
+describe('isFileEditable', () => {
+  it.each([
+    ['RDNVW', true], // own file
+    ['SDNVW', true], // "Can edit" share
+    ['W', true],
+    ['SNV', false], // "Can't delete" share: rename/move only
+    ['NV', false],
+    ['S', false], // "Can view" share
+    ['', false],
+    [undefined, false]
+  ])('%s: %s', (permissions, editable) => {
+    expect(isFileEditable(permissions)).toBe(editable)
+  })
+})
