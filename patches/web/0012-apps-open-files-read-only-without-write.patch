diff --git a/packages/web-pkg/src/components/AppTemplates/editable.ts b/packages/web-pkg/src/components/AppTemplates/editable.ts
new file mode 100644
index 0000000..964368a
--- /dev/null
+++ b/packages/web-pkg/src/components/AppTemplates/editable.ts
@@ -0,0 +1,10 @@
+import { DavPermission } from '@opencloud-eu/web-client/webdav'
+
+/**
+ * oc-custom: whether an app may open a file for editing. Only the write permission
+ * (W) counts: rename/move (NV) alone, as on oc-custom's "Can't delete" shares, opens
+ * read-only (upstream accepted either, and the server would take the overwrite).
+ */
+export function isFileEditable(permissions: string | undefined): boolean {
+  return (permissions || '').includes(DavPermission.FileUpdateable)
+}
diff --git a/packages/web-pkg/tests/unit/components/AppTemplates/editable.spec.ts b/packages/web-pkg/tests/unit/components/AppTemplates/editable.spec.ts
