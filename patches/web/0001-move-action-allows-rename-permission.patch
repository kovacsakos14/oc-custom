+++ b/packages/web-pkg/src/helpers/permissions.ts
@@ -12,5 +12,7 @@ export function canBeMoved(resource: Resource, parentPath: string) {
   const isExternal = resource.isReceivedShare() || resource.isMounted()
   const isMountedInRoot = parentPath === '' && isExternal
 
-  return resource.canBeDeleted() && !isMountedInRoot
+  // oc-custom: rename permission (NV) is enough, so roles that may move without deleting
+  // (e.g. "Can upload") get the action too
+  return (resource.canBeDeleted() || resource.canRename()) && !isMountedInRoot
 }
