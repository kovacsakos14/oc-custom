+import { mock } from 'vitest-mock-extended'
+import { User } from '@opencloud-eu/web-client/graph/generated'
+import { getComposableWrapper } from '@opencloud-eu/web-test-helpers'
+import {
+  hasOcCustomFeature,
+  ocCustomFeatures,
+  ocCustomUserTypes,
+  OcCustomFeature,
+  useOcCustomFeatures,
+  userTypeId
+} from '../../../../src/composables/ocCustom'
+
+// oc-custom: the user-type table of oc-custom's web changes
+
+const userLightId = '38071a68-456a-4553-846a-fa67bf5596cc'
+const userId = 'd7beeea8-8ff4-406b-8fb6-ab2dd81e6b11'
+
+// as the web stores it: the whole settings bundle (userManager's FIXME)
+function userWithBundle(id: string) {
+  return mock<User>({ appRoleAssignments: [{ id } as any] })
+}
+
+describe('useOcCustomFeatures', () => {
+  describe('userTypeId', () => {
+    it('reads the bundle the web stores', () => {
+      expect(userTypeId(userWithBundle(ocCustomUserTypes.client))).toBe(ocCustomUserTypes.client)
+    })
+    it("reads Graph's appRoleId too", () => {
+      const user = mock<User>({ appRoleAssignments: [{ appRoleId: userId } as any] })
+      expect(userTypeId(user)).toBe(userId)
+    })
+    it('is undefined before the user is known', () => {
+      expect(userTypeId(undefined)).toBeUndefined()
+      expect(userTypeId(mock<User>({ appRoleAssignments: [] }))).toBeUndefined()
+    })
+  })
+
+  describe('hasOcCustomFeature', () => {
+    const features = Object.keys(ocCustomFeatures) as OcCustomFeature[]
+
+    it.each(features)('applies %s to Clients', (feature) => {
+      expect(hasOcCustomFeature(feature, userWithBundle(ocCustomUserTypes.client))).toBe(true)
+    })
+    it.each(features.filter((f) => f !== 'hideTextEditor'))(
+      'applies %s to Employees',
+      (feature) => {
+        expect(hasOcCustomFeature(feature, userWithBundle(ocCustomUserTypes.employee))).toBe(true)
+      }
+    )
+    it('keeps the Text Editor for Employees', () => {
+      expect(hasOcCustomFeature('hideTextEditor', userWithBundle(ocCustomUserTypes.employee))).toBe(
+        false
+      )
+    })
+    it.each(features)("doesn't apply %s to upstream's types", (feature) => {
+      expect(hasOcCustomFeature(feature, userWithBundle(userId))).toBe(false)
+      expect(hasOcCustomFeature(feature, userWithBundle(userLightId))).toBe(false)
+      expect(hasOcCustomFeature(feature, undefined)).toBe(false)
+    })
+  })
+
+  it('answers for the signed-in user', () => {
+    getComposableWrapper(
+      () => {
+        const { has } = useOcCustomFeatures()
+        expect(has('hideTextEditor')).toBe(true)
+      },
+      {
+        pluginOptions: {
+          piniaOptions: { userState: { user: userWithBundle(ocCustomUserTypes.client) } }
+        }
+      }
+    )
+  })
+})
