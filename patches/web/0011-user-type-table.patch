+import { unref } from 'vue'
+import { User } from '@opencloud-eu/web-client/graph/generated'
+import { useUserStore } from '../piniaStores'
+
+// oc-custom: which of oc-custom's web changes apply to which user type. Upstream's
+// types (Admin, Space Admin, User, User Light) get upstream's behaviour. Changing
+// who gets what means editing this table only.
+
+/** oc-custom's user types (settings bundle ids, see the server's defaults_custom.go) */
+export const ocCustomUserTypes = {
+  client: '38f0649f-b600-4188-b138-fbd2c773cc43',
+  employee: '12047bc6-9aa3-49f6-8d78-e64b3065cd99'
+} as const
+
+const { client, employee } = ocCustomUserTypes
+
+export const ocCustomFeatures = {
+  /** a drive that doesn't resolve (no personal space) leads to "Shared with me", not Spaces */
+  sharesLanding: [client, employee],
+  /** no Personal entry, and a personal space is ignored (a User changed to one of these types
+   * keeps theirs, disabled, and the server still lists it) */
+  noPersonal: [client, employee],
+  /** no Spaces entry in the files menu */
+  hideSpaces: [client, employee],
+  /** shares can't be hidden, and "Shared with me" lists them all */
+  noHideShares: [client, employee],
+  /** no "Copy permanent link" */
+  noPermanentLink: [client, employee],
+  /** the Text Editor isn't in the app menu or the "New" menu (text files still open in it) */
+  hideTextEditor: [client]
+} satisfies Record<string, readonly string[]>
+
+export type OcCustomFeature = keyof typeof ocCustomFeatures
+
+/** the id of the user's type, or undefined before the user is known */
+export function userTypeId(user: User | undefined): string | undefined {
+  // the web keeps the whole settings bundle here (userManager's FIXME), Graph keeps appRoleId
+  const { appRoleId, id } = (user?.appRoleAssignments?.[0] || {}) as Record<string, unknown>
+  return [appRoleId, id].find((value): value is string => typeof value === 'string')
+}
+
+export function hasOcCustomFeature(feature: OcCustomFeature, user: User | undefined): boolean {
+  const id = userTypeId(user)
+  return !!id && (ocCustomFeatures[feature] as readonly string[]).includes(id)
+}
+
+export function useOcCustomFeatures() {
+  const userStore = useUserStore()
+  /** whether the feature applies to the signed-in user; reactive when used in a computed */
+  function has(feature: OcCustomFeature) {
+    return hasOcCustomFeature(feature, unref(userStore.user))
+  }
+  return { has }
+}
