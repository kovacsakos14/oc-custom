+++ b/packages/web-app-files/tests/unit/composables/actions/files/useFileActionsDisableSyncCustom.spec.ts
@@ -0,0 +1,55 @@
+import { unref } from 'vue'
+import { useFileActionsDisableSync } from '../../../../../src/composables/actions/files'
+import {
+  defaultComponentMocks,
+  getComposableWrapper,
+  RouteLocation
+} from '@opencloud-eu/web-test-helpers'
+import { mock } from 'vitest-mock-extended'
+import { IncomingShareResource } from '@opencloud-eu/web-client'
+import { User } from '@opencloud-eu/web-client/graph/generated'
+
+// oc-custom: Clients and Employees can't disable a share's sync; upstream's types can
+
+describe('useFileActionsDisableSync (oc-custom)', () => {
+  describe('isVisible property', () => {
+    it.each([
+      ['User', 'd7beeea8-8ff4-406b-8fb6-ab2dd81e6b11', true],
+      ['Client', '38f0649f-b600-4188-b138-fbd2c773cc43', false],
+      ['Employee', '12047bc6-9aa3-49f6-8d78-e64b3065cd99', false]
+    ])('in "Shared with me" for a %s: %s', (_, typeId, visible) => {
+      getWrapper({
+        typeId,
+        setup: ({ actions }) => {
+          expect(
+            unref(actions)[0].isVisible({
+              space: null,
+              resources: [{ syncEnabled: true } as IncomingShareResource]
+            })
+          ).toBe(visible)
+        }
+      })
+    })
+  })
+})
+
+function getWrapper({
+  setup,
+  typeId
+}: {
+  setup: (instance: ReturnType<typeof useFileActionsDisableSync>) => void
+  typeId: string
+}) {
+  const mocks = defaultComponentMocks({
+    currentRoute: mock<RouteLocation>({ name: 'files-shares-with-me' })
+  })
+  return getComposableWrapper(() => setup(useFileActionsDisableSync()), {
+    mocks,
+    provide: mocks,
+    pluginOptions: {
+      piniaOptions: {
+        userState: { user: mock<User>({ appRoleAssignments: [{ id: typeId } as any] }) }
+      }
+    }
+  })
+}
