@@ -161,4 +161,41 @@ describe('AuthService', () => {
       expect(mockUpdateContext).toHaveBeenCalledWith('access-token', 'session-id', true)
     })
   })
+
+  describe('logoutUser (oc-custom)', () => {
+    const getService = (logoutUrl?: string) => {
+      const authService = new AuthService()
+      const removeUser = vi.fn()
+      Object.defineProperty(authService, 'userManager', {
+        value: mock<UserManager>({
+          metadataService: { getEndSessionEndpoint: vi.fn().mockResolvedValue(undefined) },
+          removeUser
+        })
+      })
+      const router = mock<Router>()
+      createTestingPinia()
+      const configStore = useConfigStore()
+      configStore.options = { logoutUrl }
+      initAuthService({ authService, configStore, router })
+      return { authService, removeUser, router }
+    }
+
+    it('without a sign-out endpoint, goes to logoutUrl when set', async () => {
+      const assign = vi.fn()
+      vi.stubGlobal('location', { ...window.location, assign })
+      const { authService, removeUser, router } = getService('https://idp.test/logout?rd=x')
+      await authService.logoutUser()
+      expect(removeUser).toHaveBeenCalled()
+      expect(assign).toHaveBeenCalledWith('https://idp.test/logout?rd=x')
+      expect(router.push).not.toHaveBeenCalled()
+      vi.unstubAllGlobals()
+    })
+
+    it('without a sign-out endpoint and logoutUrl, shows the logout page as upstream', async () => {
+      const { authService, removeUser, router } = getService()
+      await authService.logoutUser()
+      expect(removeUser).toHaveBeenCalled()
+      expect(router.push).toHaveBeenCalledWith({ name: 'logout' })
+    })
+  })
 })
