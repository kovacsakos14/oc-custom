@@ -0,0 +1,73 @@
+import { mock, mockDeep } from 'vitest-mock-extended'
+import { Language } from 'vue3-gettext'
+import { UploadResourceConflict } from '../../../../../src/helpers/resource'
+import { ResolveStrategy, OcUppyFile, useResourcesStore } from '@opencloud-eu/web-pkg'
+import { Resource } from '@opencloud-eu/web-client'
+import { createTestingPinia } from '@opencloud-eu/web-test-helpers'
+
+// oc-custom: no Replace for a file the server won't let the user replace ("Can't delete":
+// rename/move without write, and content); otherwise as upstream
+
+const instanceWith = (currentFiles: Resource[]) => {
+  createTestingPinia({ initialState: { resources: { resources: currentFiles } } })
+  return new UploadResourceConflict(useResourcesStore(), mock<Language>())
+}
+const upload = (name: string) =>
+  mockDeep<OcUppyFile>({ name, meta: { relativePath: '', relativeFolder: '' } })
+
+describe('upload helper (oc-custom)', () => {
+  describe('getConflicts', () => {
+    it.each([
+      ['SNV', 10, false], // "Can't delete", with content
+      ['NV', '10', false],
+      ['SNV', 0, true], // empty: Windows Explorer and macOS Finder create files empty
+      ['SDNVW', 10, true], // "Can edit"
+      ['S', 10, true], // upstream's "Can upload": as upstream
+      ['RDNVW', 10, true] // own file
+    ])('a %s file of size %s may be replaced: %s', (permissions, size, replaceable) => {
+      const instance = instanceWith([mock<Resource>({ name: 'a.txt', permissions, size })])
+      const expected = replaceable
+        ? { name: 'a.txt', type: 'file' }
+        : { name: 'a.txt', type: 'file', replaceable: false }
+      expect(instance.getConflicts([upload('a.txt')])).toEqual([expected])
+    })
+  })
+
+  describe('displayOverwriteDialog', () => {
+    it('asks without Replace for a file that may not be replaced', async () => {
+      const instance = instanceWith([])
+      instance.resolveFileExists = vi.fn(() =>
+        Promise.resolve({ strategy: ResolveStrategy.KEEP_BOTH, doForAllConflicts: false })
+      )
+      await instance.displayOverwriteDialog(
+        [upload('a.txt')],
+        [{ name: 'a.txt', type: 'file', replaceable: false }]
+      )
+      expect(instance.resolveFileExists).toHaveBeenCalledWith(
+        expect.anything(),
+        1,
+        false,
+        true,
+        false
+      )
+    })
+    it("doesn't apply a Replace for all to a file that may not be replaced", async () => {
+      const instance = instanceWith([])
+      instance.resolveFileExists = vi
+        .fn()
+        .mockResolvedValueOnce({ strategy: ResolveStrategy.REPLACE, doForAllConflicts: true })
+        .mockResolvedValueOnce({ strategy: ResolveStrategy.SKIP, doForAllConflicts: false })
+      const result = await instance.displayOverwriteDialog(
+        [upload('a.txt'), upload('b.txt'), upload('c.txt')],
+        [
+          { name: 'a.txt', type: 'file' },
+          { name: 'b.txt', type: 'file', replaceable: false },
+          { name: 'c.txt', type: 'file' }
+        ]
+      )
+      // asked for a.txt (Replace for all), again for b.txt (skipped); c.txt took the Replace
+      expect(instance.resolveFileExists).toHaveBeenCalledTimes(2)
+      expect(result.files.map(({ name }) => name)).toEqual(['a.txt', 'c.txt'])
+    })
+  })
+})
